# ==================== Application ====================
APP_NAME=Knowledge Base
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ==================== Database (MySQL) ====================
DATABASE_URL=mysql+asyncmy://kb_user:kb_pass123@localhost:3306/knowledge_base?charset=utf8mb4

# ==================== Elasticsearch ====================
ELASTICSEARCH_URL=http://localhost:9200
ES_NOTES_INDEX=notes_index
ES_DOCUMENTS_INDEX=documents_index

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0

# ==================== MinIO ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=knowledge-base
MINIO_SECURE=false

# ==================== JWT Auth ====================
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Celery ====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==================== LLM / AI ====================
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ==================== Embedding ====================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
